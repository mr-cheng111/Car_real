<?xml version="1.0" encoding="utf-8"?>
<robot name="differential_robot" xmlns:xacro="http://ros.org/wiki/xacro">
  
  <!-- 常量定义 -->
  <xacro:property name="M_PI" value="3.1415926535897931"/>
  
  <!-- 底盘参数 -->
  <xacro:property name="base_mass" value="2.0"/>
  <xacro:property name="base_length" value="0.25"/>
  <xacro:property name="base_width" value="0.22"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="base_link_height" value="${base_height/2}"/>  <!-- base_link 位于车体中心，高于地面 5cm -->
  
  <!-- 轮子参数 -->
  <xacro:property name="wheel_radius" value="0.035"/>  <!-- 直径7cm，半径3.5cm -->
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.15"/>
  <xacro:property name="track_width" value="0.2948"/>  <!-- 左右轮中心距 294.8mm -->
  
  <!-- 万向轮参数 -->
  <xacro:property name="caster_radius" value="0.015"/>
  <xacro:property name="caster_mass" value="0.05"/>
  <xacro:property name="caster_x" value="-0.12"/>     <!-- 后方支撑万向轮：x<0 -->

  <!--
    IMU measured offset in base_link frame (meter).
    Derived from shell-center measurements with wheel-midpoint as the original base_link proxy:
    imu=(-35.7881, 5.1315, -34.0128)mm
    wheel_mid=(100, 0, -124.72)mm
    imu-base = (-135.7881, 5.1315, 90.7072)mm
    IMU 实体为倒装安装，并且相对 base_link 还绕 z 轴旋转了 -90deg。
    因此 imu_link 相对 base_link 的旋转取：
    R = Rz(-pi/2) * Rx(pi)
    对应坐标轴关系为：
    x_base = -y_imu
    y_base = -x_imu
    z_base = -z_imu
    因此对应 imu_cartographer_publisher 的 axis_map=-y,-x,-z。
  -->
  <xacro:property name="imu_x" value="-0.1357881"/>
  <xacro:property name="imu_y" value="0.0051315"/>
  <xacro:property name="imu_z" value="0.0907072"/>
  
  <!-- 雷达参数 -->
  <xacro:property name="laser_height" value="0.2"/>   <!-- 雷达高度20cm -->

  <!-- 惯性矩阵宏 -->
  <xacro:macro name="cylinder_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12}"
        ixy="0"
        ixz="0"
        iyy="${m*(3*r*r+h*h)/12}"
        iyz="0"
        izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(h*h+d*d)/12}"
        ixy="0"
        ixz="0"
        iyy="${m*(w*w+d*d)/12}"
        iyz="0"
        izz="${m*(w*w+h*h)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2*m*r*r/5}"
        ixy="0"
        ixz="0"
        iyy="${2*m*r*r/5}"
        iyz="0"
        izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- 颜色定义 -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.2 0.8 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1"/>
  </material>

  <!-- 基础坐标系 base_footprint（地面接触点） -->
  <link name="base_footprint"/>

  <!-- base_link（底盘主体） -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:box_inertial m="${base_mass}" w="${base_width}" h="${base_height}" d="${base_length}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- 左驱动轮 -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${track_width/2} ${wheel_radius-base_link_height}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <xacro:cylinder_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <!-- 右驱动轮 -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 ${-track_width/2} ${wheel_radius-base_link_height}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <xacro:cylinder_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <!-- 后万向轮（辅助支撑轮） -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${caster_x} 0 ${caster_radius-base_link_height}" rpy="0 0 0"/>
  </joint>

  <link name="caster_wheel">
    <xacro:sphere_inertial m="${caster_mass}" r="${caster_radius}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
  </link>

  <!-- 激光雷达（思岚C1） -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 ${laser_height-base_link_height}" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU frame -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${wheel_radius+imu_z-base_link_height}" rpy="${M_PI} 0 -${M_PI/2}"/>
  </joint>

  <link name="imu_link"/>

</robot>
